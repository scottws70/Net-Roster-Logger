{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N8VCL Net Roster Logger",
  "version": "1.41.0",
  "identifier": "com.n8vcl.roster-logger",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "N8VCL Net Roster Logger",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/photos/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRDg3QzIzN0ExQ0U1MEMKUldRTTVSeDZJM3pZVExIQ0M4NEJrLzZoRUVFeCthOE1DSk5MQkhVY0ZBMTJxSDlrNXl3V3ZpaUwK",
      "endpoints": [
        "https://github.com/scottws70/Net-Roster-Logger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
